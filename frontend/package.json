{
  "name": "noordveld-machinery",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5180",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 5180",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "perf:ui": "vitest run --config vitest.perf.config.ts",
    "lint": "oxlint src agentic-commerce/src agentic-commerce/remotion --deny-warnings",
    "film:preview": "remotion studio agentic-commerce/remotion/index.ts",
    "film:render": "remotion render agentic-commerce/remotion/index.ts EvolutionFilm --crf=18 agentic-commerce/film-masters/16x9.mp4",
    "film:render:square": "remotion render agentic-commerce/remotion/index.ts EvolutionFilmSquare --crf=18 agentic-commerce/film-masters/1x1.mp4",
    "film:render:vertical": "remotion render agentic-commerce/remotion/index.ts EvolutionFilmVertical --crf=18 agentic-commerce/film-masters/9x16.mp4",
    "film:poster": "remotion still agentic-commerce/remotion/index.ts EvolutionFilm --frame=560 public/evolution-film-16x9.jpg && remotion still agentic-commerce/remotion/index.ts EvolutionFilmSquare --frame=560 public/evolution-film-1x1.jpg",
    "film:encode": "node scripts/encode-film.mjs",
    "format": "prettier --write src agentic-commerce/src agentic-commerce/remotion vite.config.ts package.json",
    "format:check": "prettier --check src agentic-commerce/src agentic-commerce/remotion vite.config.ts package.json",
    "check": "npm run typecheck && npm run lint && npm run format:check",
    "film:workflow:audio": "python scripts/workflow-film-audio.py",
    "film:workflow": "remotion render agentic-commerce/remotion/index.ts WorkflowFilm --public-dir agentic-commerce/film-sources/workflow --crf=18 agentic-commerce/film-masters/workflow-16x9.mp4",
    "film:workflow:encode": "node scripts/workflow-film-encode.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@gsap/react": "^2.1.2",
    "@remotion/cli": "^4.0.532",
    "gsap": "^3.15.0",
    "lucide-react": "^1.49.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "remotion": "^4.0.532"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "esbuild": "0.28.1",
    "jsdom": "^29.1.1",
    "oxlint": "^1.86.0",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
