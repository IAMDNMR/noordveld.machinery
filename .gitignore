# Dependencies and build output
frontend/node_modules/
frontend/dist/
frontend/dist-*/
frontend/*.tsbuildinfo
*.local

# Large originals (not code): source images/videos and Remotion masters
frontend/assets-source/
frontend/agentic-commerce/film-masters/

# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/

# Environment files: ignored by default. backend/.env is added deliberately (private repo, by the owner's request).
.env
.env.*
!.env.example

# Regenerated on every run by backend/scripts/eu_foundation (validate.py, scenarios.py, build.py plan): output, not source
backend/data/eu_foundation/validation.json
backend/data/eu_foundation/scenarios.json
backend/data/eu_foundation/plan_summary.json

# Machine-readable reports of canonical ingestion runs (regenerated by backend/scripts/canonical.py)
backend/data/canonical/reports/
