# Copy to .env (git-ignored) and fill in. Never commit .env.
NEO4J_URI=
NEO4J_USERNAME=
NEO4J_PASSWORD=
NEO4J_DATABASE=
# Comma-separated origins the API accepts requests from
CORS_ORIGINS=http://localhost:5180
# Language model (understanding + grounded wording for Parts Intelligence and Agentic Shopping). Backend only; never in the frontend.
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
# Optional alternative provider (LLM_PROVIDER=gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# Optional tuning
LLM_REQUESTS_PER_MINUTE=25
LLM_TIMEOUT=20
# Signs the demo session cookie (any long random string). Without it a new one is made at each start.
SESSION_SECRET=
