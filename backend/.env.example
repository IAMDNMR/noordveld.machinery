# Copy to .env (git-ignored) and fill in. Never commit .env.
NEO4J_URI=
NEO4J_USERNAME=
NEO4J_PASSWORD=
NEO4J_DATABASE=
# Comma-separated origins the API accepts requests from
CORS_ORIGINS=http://localhost:5180
# Language model for Parts Intelligence (optional; deterministic questions work without it)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
