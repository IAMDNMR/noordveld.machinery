{
  "id": "inventory_supply",
  "version": "1.0.0",
  "name": "Inventory & Supply",
  "category": "Inventory",
  "summary": "Stock by warehouse, movements, replenishment, alerts and transfers.",
  "description": "A data-rich inventory workspace: stock levels by warehouse and location, every movement in order, low-stock and excess alerts with the action to take, replenishment requests and transfers between sites.",
  "status": "preview",
  "domain_ids": ["inventory_supply_chain", "warehouse_management"],
  "app_type": "Inventory control",
  "users": ["Inventory controller", "Planner", "Purchase manager"],
  "keywords": ["inventory", "stock", "replenishment", "reorder", "transfer", "movement", "low stock", "excess", "supply", "demand", "warehouse", "level"],
  "theme": {
    "id": "data_dense",
    "label": "Data dense",
    "direction": "Slate interface with a teal accent and striped compact tables; metrics are small, numbers are tabular and alerts carry the action.",
    "colors": {
      "primary": "#0F766E", "primary_text": "#FFFFFF", "accent": "#7C3AED",
      "background": "#F1F5F9", "surface": "#FFFFFF", "surface_alt": "#E2E8F0",
      "text": "#0F172A", "muted": "#475569", "border": "#CBD5E1",
      "nav_background": "#1E293B", "nav_text": "#E2E8F0",
      "success": "#15803D", "warning": "#B45309", "danger": "#B91C1C"
    },
    "font_heading": "grotesk", "font_body": "system", "density": "compact",
    "radius": 4, "shadow": "none", "card_style": "flat", "table_style": "striped"
  },
  "nav_style": "rail",
  "profile": "operations",
  "entity_roles": [
    {"id": "stock", "label": "Stock level", "matches": ["stock", "inventory", "item", "level"], "fields": ["item", "warehouse", "on_hand", "reorder_level", "status"]},
    {"id": "movement", "label": "Movement", "matches": ["movement", "transaction", "entry"], "fields": ["time", "item", "kind", "quantity", "warehouse"]},
    {"id": "transfer", "label": "Transfer", "matches": ["transfer"], "fields": ["number", "item", "from_warehouse", "to_warehouse", "status"]}
  ],
  "pages": [
    {"id": "overview", "title": "Inventory", "icon": "Boxes", "layout": "overview", "purpose": "Stock health across warehouses.", "users": ["Inventory controller"],
     "components": [
       {"type": "metric_strip", "title": "Stock status", "role": "stock", "group_by": "status", "span": 3},
       {"type": "alert_panel", "title": "Low and excess stock", "role": "stock", "fields": ["item", "warehouse", "on_hand"], "group_by": "status", "span": 1},
       {"type": "data_table", "title": "Stock levels", "role": "stock", "fields": ["item", "warehouse", "on_hand", "reorder_level", "status"], "span": 2}
     ]},
    {"id": "movements", "title": "Movements", "icon": "ArrowLeftRight", "layout": "table", "purpose": "Every receipt, issue and adjustment.", "users": ["Inventory controller"],
     "components": [
       {"type": "data_table", "title": "Stock movements", "role": "movement", "fields": ["time", "item", "kind", "quantity", "warehouse"], "span": 3}
     ]},
    {"id": "transfers", "title": "Transfers", "icon": "Repeat", "layout": "board", "purpose": "Move stock between sites.", "users": ["Planner"],
     "components": [
       {"type": "status_board", "title": "Transfers", "role": "transfer", "fields": ["number", "item", "to_warehouse"], "group_by": "status", "span": 3}
     ]}
  ],
  "modules": [
    {"id": "levels", "name": "Stock by warehouse and location", "status": "supported", "keywords": ["stock", "level", "inventory", "warehouse"]},
    {"id": "movements", "name": "Movement history", "status": "supported", "keywords": ["movement", "history", "transaction"]},
    {"id": "replenishment", "name": "Reorder levels and replenishment", "status": "supported", "keywords": ["reorder", "replenish", "replenishment", "low"]},
    {"id": "transfers", "name": "Transfers between sites", "status": "supported", "keywords": ["transfer", "move", "site"]},
    {"id": "forecast", "name": "Demand forecasting", "status": "requires_integration", "keywords": ["forecast", "demand", "prediction"], "note": "Needs sales history from an ERP integration delivered by our partner."}
  ],
  "limitations": ["Demand forecasts need sales history from an ERP integration provided by our partner."],
  "sample": {
    "stock": [
      {"id": "i1", "item": "Hydraulic filter", "warehouse": "Rotterdam", "on_hand": 38, "reorder_level": 20, "status": "OK"},
      {"id": "i2", "item": "Lift chain", "warehouse": "Rotterdam", "on_hand": 2, "reorder_level": 5, "status": "Low"},
      {"id": "i3", "item": "Seat cushion", "warehouse": "Hamburg", "on_hand": 140, "reorder_level": 10, "status": "Excess"}
    ],
    "movement": [
      {"id": "mv1", "time": "2026-10-21 09:20", "item": "Hydraulic filter", "kind": "Receipt", "quantity": 24, "warehouse": "Rotterdam"}
    ],
    "transfer": [
      {"id": "tf1", "number": "TF-77", "item": "Seat cushion", "from_warehouse": "Hamburg", "to_warehouse": "Rotterdam", "status": "Requested"}
    ]
  }
}
