{
  "id": "service_warranty",
  "version": "1.0.0",
  "name": "Service & Warranty",
  "category": "After-sales",
  "summary": "Service cases, warranty review, work orders and technician queues around the equipment.",
  "description": "An equipment-centred after-sales app: every case starts from a machine and its warranty, technicians work from their own queue, warranty decisions show their reasons, and the service history of each machine is one timeline.",
  "status": "preview",
  "domain_ids": ["aftersales_service", "spare_parts_commerce"],
  "app_type": "Service operations",
  "users": ["Customer", "Service coordinator", "Technician", "Warranty manager"],
  "keywords": ["service", "warranty", "claim", "repair", "maintenance", "technician", "visit", "work order", "case", "installation", "serial", "equipment", "machine"],
  "theme": {
    "id": "equipment_service",
    "label": "Equipment service",
    "direction": "Calm off-white with Noordveld teal; equipment cards and timelines lead, statuses read as plain words.",
    "colors": {
      "primary": "#0B7A66", "primary_text": "#FFFFFF", "accent": "#12A88A",
      "background": "#F5F7F6", "surface": "#FFFFFF", "surface_alt": "#E8EFEC",
      "text": "#13222E", "muted": "#4A5A63", "border": "#D5DEDB",
      "nav_background": "#13222E", "nav_text": "#E7EFEC",
      "success": "#15803D", "warning": "#B45309", "danger": "#B91C1C"
    },
    "font_heading": "grotesk", "font_body": "humanist", "density": "comfortable",
    "radius": 10, "shadow": "soft", "card_style": "elevated", "table_style": "lined"
  },
  "nav_style": "dark_sidebar",
  "profile": "service",
  "entity_roles": [
    {"id": "case", "label": "Service case", "matches": ["case", "claim", "ticket", "request"], "fields": ["number", "machine", "issue", "status", "warranty"]},
    {"id": "equipment", "label": "Equipment", "matches": ["machine", "equipment", "asset", "unit"], "fields": ["serial", "model", "customer", "warranty_until"]},
    {"id": "work_order", "label": "Work order", "matches": ["work order", "visit", "job", "repair"], "fields": ["number", "technician", "date", "status"]},
    {"id": "event", "label": "Service event", "matches": ["history", "event", "installation"], "fields": ["date", "machine", "event"]}
  ],
  "pages": [
    {"id": "cases", "title": "Service cases", "icon": "LifeBuoy", "layout": "board", "purpose": "Every case from open to closed.", "users": ["Service coordinator"],
     "components": [
       {"type": "status_board", "title": "Cases", "role": "case", "fields": ["number", "machine", "issue"], "group_by": "status", "span": 3}
     ]},
    {"id": "warranty", "title": "Warranty review", "icon": "ShieldCheck", "layout": "queue", "purpose": "Decide warranty claims with their reasons.", "users": ["Warranty manager"],
     "components": [
       {"type": "task_queue", "title": "Claims to review", "role": "case", "fields": ["number", "machine", "issue", "warranty"], "span": 3}
     ]},
    {"id": "technician", "title": "My work orders", "icon": "Wrench", "layout": "queue", "purpose": "Today's visits and repairs.", "users": ["Technician"],
     "components": [
       {"type": "task_queue", "title": "Work orders", "role": "work_order", "fields": ["number", "date", "status"], "span": 3}
     ]},
    {"id": "equipment", "title": "Equipment", "icon": "Tractor", "layout": "split", "purpose": "A machine, its warranty and its history.", "users": ["Service coordinator"],
     "components": [
       {"type": "detail_panel", "title": "Machine", "role": "equipment", "fields": ["serial", "model", "customer", "warranty_until"], "span": 1},
       {"type": "timeline", "title": "Service history", "role": "event", "fields": ["date", "machine", "event"], "span": 2}
     ]}
  ],
  "modules": [
    {"id": "cases", "name": "Service cases", "status": "supported", "keywords": ["case", "ticket", "issue", "service"]},
    {"id": "warranty", "name": "Warranty claim review", "status": "supported", "keywords": ["warranty", "claim", "coverage", "eligible"]},
    {"id": "work_orders", "name": "Work orders and technician queues", "status": "supported", "keywords": ["technician", "visit", "work order", "repair"]},
    {"id": "history", "name": "Equipment and service history", "status": "supported", "keywords": ["history", "equipment", "machine", "installation", "serial"]},
    {"id": "notifications", "name": "Customer e-mail and SMS updates", "status": "requires_integration", "keywords": ["email", "sms", "notify", "message"], "note": "Needs a messaging integration delivered by our partner."}
  ],
  "limitations": ["Customer e-mail and SMS updates need a messaging integration from our partner."],
  "sample": {
    "case": [
      {"id": "sc1", "number": "SC-118", "machine": "NF-25 #A1042", "issue": "Hydraulic leak", "status": "Open", "warranty": "Under warranty"},
      {"id": "sc2", "number": "SC-119", "machine": "NL-80 #B2210", "issue": "Brake noise", "status": "In repair", "warranty": "Review"}
    ],
    "equipment": [
      {"id": "eq1", "serial": "A1042", "model": "NF-25", "customer": "Sample Logistics", "warranty_until": "2027-03-31"}
    ],
    "work_order": [
      {"id": "wo1", "number": "WO-5521", "technician": "Technician A", "date": "2026-10-23", "status": "Scheduled"}
    ],
    "event": [
      {"id": "ev1", "date": "2026-04-02", "machine": "NF-25 #A1042", "event": "Installed at customer site"},
      {"id": "ev2", "date": "2026-09-12", "machine": "NF-25 #A1042", "event": "Hydraulic filter replaced"}
    ]
  }
}
