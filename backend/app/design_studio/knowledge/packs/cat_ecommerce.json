 "business": {
  "requirements": [
   {
    "id": "req_eco_order",
    "statement": "Orders are entered, checked against stock and payment, and confirmed.",
    "kind": "functional",
    "priority": "must",
    "status": "agreed",
    "acceptance_criteria": [
     {
      "id": "ac_eco_order_1",
      "statement": "An agent enters an order with its lines."
     },
     {
      "id": "ac_eco_order_2",
      "statement": "An order is confirmed only when stock is available and payment is received."
     },
     {
      "id": "ac_eco_order_3",
      "statement": "A failed payment cancels the order."
     }
    ]
   },
   {
    "id": "req_eco_track",
    "statement": "Everyone can see where an order stands.",
    "kind": "functional",
    "priority": "should",
    "status": "agreed",
    "acceptance_criteria": [
     {
      "id": "ac_eco_track_1",
      "statement": "The order's current step and history are visible."
     }
    ]
   },
   {
    "id": "req_eco_audit",
    "statement": "Every change to a record and every process step is recorded with who did it and when.",
    "kind": "non_functional",
    "category": "auditability",
    "priority": "must",
    "status": "agreed",
    "acceptance_criteria": [
     {
      "id": "ac_eco_audit_1",
      "statement": "The history of a process shows each step with its actor and time."
     }
    ]
   }
  ],
