       "PHONE",
       "EMAIL",
       "MARKETPLACE"
      ]
     },
     {
      "id": "status",
      "name": "Status",
      "type": "string",
      "required": true,
      "sensitivity": "internal",
      "enum": [
       "NEW",
       "CONFIRMED",
       "IN_FULFILMENT",
       "COMPLETED",
       "CANCELLED"
      ]
     },
     {
      "id": "payment_status",
      "name": "Payment status",
      "type": "string",
      "required": false,
