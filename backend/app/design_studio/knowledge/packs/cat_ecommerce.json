  "rules": [
   {
    "id": "rule_eco_availability",
    "description": "An order line can be filled only if on-hand stock covers the quantity.",
    "type": "decision",
    "status": "assumption",
    "source": {
     "kind": "synthetic_assumption",
     "reference": "Catalog design assumption: the business has not stated this rule. It lets the demonstration run and is not company policy."
    },
    "condition": "",
    "outcomes": [
     "IN_STOCK",
     "SHORT"
    ],
    "execution": {
     "kind": "compare",
     "field": "ent_inv_stock_level.on_hand",
     "operator": "gte",
     "value": null,
     "other_field": "ent_eco_order_line.quantity",
     "pass_outcome": "IN_STOCK",
     "fail_outcome": "SHORT"
    }
   },
   {
    "id": "rule_eco_payment",
    "description": "The recorded payment status decides whether the order is confirmed.",
    "type": "decision",
    "status": "assumption",
    "source": {
     "kind": "synthetic_assumption",
     "reference": "Catalog design assumption: the business has not stated this rule. It lets the demonstration run and is not company policy."
    },
    "condition": "",
    "outcomes": [
     "PAID",
     "PENDING",
     "FAILED"
    ],
    "execution": {
     "kind": "value",
     "field": "ent_eco_order.payment_status",
     "operator": "present",
     "value": null,
     "other_field": null,
     "pass_outcome": null,
     "fail_outcome": null
    }
   }
  ],
  "exceptions": [
   {
    "id": "exc_eco_backorder",
    "name": "Stock is short",
    "trigger": "On-hand stock does not cover an order line.",
    "recovery": "The agent resolves the shortage and the check is repeated.",
    "resolution": "recover",
    "resolution_state_id": "st_eco_order_avail"
   },
   {
    "id": "exc_eco_payment_late",
    "name": "Payment not received",
    "trigger": "Payment is still pending when the order is ready to confirm.",
    "recovery": "The payments clerk chases payment and the check is repeated.",
    "resolution": "recover",
    "resolution_state_id": "st_eco_order_pay_check"
   }
  ],
  "decisions": [
   {
    "id": "dec_eco_backorder",
    "question": "Does the company accept backorders, or cancel the order when stock is short?",
    "status": "open",
    "answer": "",
    "deferral_reason": "",
    "affects": [
     "rule_eco_availability"
    ]
   },
   {
    "id": "dec_eco_terms",
