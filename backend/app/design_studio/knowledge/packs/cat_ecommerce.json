 "title": "E-commerce and order management",
 "description": "Customer orders from entry through availability, payment and confirmation.",
 "synthetic": true,
 "status": "in_review",
 "provenance": {
  "kind": "synthetic",
  "reference": "Authored for the reference catalog from common industry practice; no company or customer source.",
  "verification": "unverified"
 },
