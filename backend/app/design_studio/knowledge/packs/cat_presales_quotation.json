        "resolution_state_id": "st_psl_q_submit"
      },
      {
        "id": "exc_psl_lost",
        "name": "Quotation lost",
        "trigger": "The deal does not proceed.",
        "recovery": "The quotation is set as lost with the reason, competitors and an explanation.",
        "resolution": "terminate",
        "resolution_state_id": "st_psl_q_lost"
      },
      {
        "id": "exc_psl_expired",
        "name": "Quotation expired",
