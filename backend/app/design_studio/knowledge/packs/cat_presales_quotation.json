{
  "id": "cat_presales_quotation",
  "version": "2026.10.22",
  "layer": "business",
  "title": "Pre-sales: lead, opportunity, quotation and sales order",
  "description": "How a lead is followed up and qualified, becomes an opportunity, is quoted and ends as a sales order or a lost deal, as documented by the ERPNext selling manual.",
  "synthetic": false,
  "status": "approved",
  "provenance": {
    "kind": "verified_source",
    "reference": "Official documentation, read and checked 2026-10-21: docs.frappe.io/erpnext/user/manual/en/lead; docs.frappe.io/erpnext/user/manual/en/opportunity; docs.frappe.io/erpnext/user/manual/en/quotation; docs.frappe.io/erpnext/user/manual/en/sales-order",
    "verification": "verified"
  },
  "depends_on": [],
  "uses_capabilities": [
    "audit_history",
    "search_filter"
  ],
  "dependency_mode": "full",
  "includes": [],
  "business": {
    "requirements": [
      {
        "id": "req_psl_lead",
        "statement": "A potential customer is recorded as a lead with its source, whether it is an organisation or a person, and its contact details; leads are assigned to sales executives manually or by assignment rules.",
        "kind": "functional",
        "priority": "must",
        "status": "agreed",
        "acceptance_criteria": [
          {
            "id": "ac_psl_lead_1",
            "statement": "A lead has a source and a contact."
          },
          {
            "id": "ac_psl_lead_2",
            "statement": "A lead can be assigned to a sales executive."
          }
        ]
      },
      {
        "id": "req_psl_follow_up",
        "statement": "A sales executive contacts the lead and follows up with reminders; the lead's status shows whether it is open, replied, interested or not to be contacted.",
        "kind": "functional",
        "priority": "must",
        "status": "agreed",
        "acceptance_criteria": [
          {
            "id": "ac_psl_follow_up_1",
            "statement": "A follow-up reminder is set with a next contact date."
          },
          {
            "id": "ac_psl_follow_up_2",
            "statement": "A lead marked do not contact gets no further communication."
          }
        ]
      },
      {
        "id": "req_psl_opportunity",
        "statement": "A lead that is qualified becomes an opportunity with a type, an amount, a probability and a source; an opportunity with no response for a configured number of days closes automatically.",
        "kind": "functional",
        "priority": "must",
        "status": "agreed",
        "acceptance_criteria": [
          {
            "id": "ac_psl_opportunity_1",
            "statement": "An opportunity records its amount and probability."
          },
          {
            "id": "ac_psl_opportunity_2",
            "statement": "An opportunity closes after the configured days without response."
          }
        ]
      },
      {
        "id": "req_psl_quote",
        "statement": "A quotation is prepared for a lead or customer with items, rates, taxes, payment terms and a valid-till date, saved as a draft and submitted as the offer sent; a submitted quotation is changed only by cancelling and amending it.",
        "kind": "functional",
        "priority": "must",
        "status": "agreed",
        "acceptance_criteria": [
          {
            "id": "ac_psl_quote_1",
            "statement": "A quotation has a valid-till date."
          },
          {
            "id": "ac_psl_quote_2",
            "statement": "A submitted quotation is not silently changed."
          }
        ]
      },
      {
        "id": "req_psl_outcome",
        "statement": "A submitted quotation is open until it is ordered, lost, expired or cancelled; it expires when its valid-till date passes.",
        "kind": "functional",
        "priority": "must",
        "status": "agreed",
        "acceptance_criteria": [
          {
            "id": "ac_psl_outcome_1",
            "statement": "The quotation shows open, ordered, lost, expired or cancelled."
          }
        ]
      },
      {
        "id": "req_psl_order",
        "statement": "When the customer accepts, a sales order is created from the quotation; the sales order tracks delivery and billing.",
        "kind": "functional",
        "priority": "must",
        "status": "agreed",
        "acceptance_criteria": [
          {
            "id": "ac_psl_order_1",
            "statement": "The sales order refers to the quotation."
          }
        ]
      },
      {
        "id": "req_psl_lost",
        "statement": "When a quotation or opportunity is lost, the reason, the competitors and an explanation are recorded for trend analysis.",
        "kind": "functional",
        "priority": "must",
        "status": "agreed",
        "acceptance_criteria": [
          {
            "id": "ac_psl_lost_1",
            "statement": "A lost reason is stored."
          }
        ]
      },
      {
        "id": "req_psl_history",
        "statement": "Communication with a lead, such as emails, calls and meetings, is logged against it.",
        "kind": "non_functional",
        "priority": "should",
        "status": "agreed",
        "acceptance_criteria": [
          {
            "id": "ac_psl_history_1",
            "statement": "Activities appear on the lead."
          }
        ],
        "category": "auditability"
      }
    ],
    "roles": [
      {
        "id": "role_psl_sales",
        "name": "Sales executive",
        "responsibilities": [
          "Contacts and follows up leads",
          "Creates opportunities and quotations",
          "Creates sales orders"
