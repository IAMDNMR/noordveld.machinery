    "rules": [
      {
        "id": "rule_psl_assessment",
        "description": "A replying lead is qualified (an opportunity is created), still interested, or not to be contacted.",
        "type": "decision",
        "status": "confirmed",
        "source": {
          "kind": "document",
          "reference": "https://docs.frappe.io/erpnext/user/manual/en/lead (Lead statuses; a lead is qualified when an opportunity is created from it)"
        },
        "condition": "",
        "outcomes": [
          "QUALIFIED",
          "INTERESTED",
          "DO_NOT_CONTACT"
        ],
        "execution": {
          "kind": "value",
          "field": "ent_psl_lead.assessment",
          "operator": "present",
          "value": null,
          "other_field": null,
          "pass_outcome": null,
          "fail_outcome": null
        }
      },
      {
        "id": "rule_psl_response",
        "description": "An opportunity with no response for the configured number of days closes automatically.",
        "type": "decision",
        "status": "confirmed",
        "source": {
          "kind": "document",
          "reference": "https://docs.frappe.io/erpnext/user/manual/en/opportunity (Auto-close: days configured in Selling Settings)"
        },
        "condition": "",
        "outcomes": [
          "ACTIVE",
          "AUTO_CLOSED"
        ],
        "execution": {
          "kind": "compare",
          "field": "ent_psl_opportunity.days_without_response",
          "operator": "lt",
          "value": null,
          "other_field": "ent_psl_opportunity.auto_close_days",
          "pass_outcome": "ACTIVE",
          "fail_outcome": "AUTO_CLOSED"
        }
      },
      {
        "id": "rule_psl_outcome",
        "description": "A submitted quotation ends ordered, lost, expired, or is cancelled and amended.",
        "type": "decision",
        "status": "confirmed",
        "source": {
          "kind": "document",
          "reference": "https://docs.frappe.io/erpnext/user/manual/en/quotation (Outcomes: Ordered, Lost, Expired, Cancelled; revisions by cancel and amend)"
        },
        "condition": "",
        "outcomes": [
          "ORDERED",
          "LOST",
          "EXPIRED",
          "AMENDED"
        ],
        "execution": {
          "kind": "value",
          "field": "ent_psl_quotation.outcome",
          "operator": "present",
          "value": null,
          "other_field": null,
          "pass_outcome": null,
          "fail_outcome": null
        }
      }
    ],
    "exceptions": [
      {
        "id": "exc_psl_interested",
        "name": "Lead not yet qualified",
        "trigger": "The lead replied but is only interested; no opportunity is warranted yet.",
        "recovery": "The sales executive sets the next contact date and follows up again.",
        "resolution": "recover",
        "resolution_state_id": "st_psl_l_contact"
      },
      {
        "id": "exc_psl_dnc",
        "name": "Lead does not want contact",
        "trigger": "The lead is not interested and no further communication is needed.",
        "recovery": "The lead is marked do not contact and the follow-up ends.",
        "resolution": "terminate",
        "resolution_state_id": "st_psl_l_closed"
      },
      {
        "id": "exc_psl_autoclosed",
        "name": "Opportunity closed after no response",
        "trigger": "The opportunity had no response for the configured number of days.",
        "recovery": "The opportunity is closed automatically and the lost reason is recorded.",
        "resolution": "terminate",
        "resolution_state_id": "st_psl_q_lost"
      },
      {
        "id": "exc_psl_amend",
        "name": "Quotation amended",
