  "rules": [
   {
    "id": "rule_inv_variance",
    "description": "A count difference of more than 5 units needs approval before stock is adjusted.",
    "type": "decision",
    "status": "assumption",
    "source": {
     "kind": "synthetic_assumption",
     "reference": "Catalog design assumption: the business has not stated this rule. It lets the demonstration run and is not company policy."
    },
    "condition": "",
    "outcomes": [
     "WITHIN_TOLERANCE",
     "NEEDS_APPROVAL"
    ],
    "execution": {
     "kind": "compare",
     "field": "ent_inv_stock_count.variance",
     "operator": "lte",
     "value": 5,
     "other_field": null,
     "pass_outcome": "WITHIN_TOLERANCE",
     "fail_outcome": "NEEDS_APPROVAL"
    }
   },
   {
    "id": "rule_inv_reason_given",
    "description": "A reason is recorded before a difference is approved.",
    "type": "validation",
    "status": "assumption",
    "source": {
     "kind": "synthetic_assumption",
     "reference": "Catalog design assumption: the business has not stated this rule. It lets the demonstration run and is not company policy."
    },
    "condition": "",
    "outcomes": [],
    "execution": {
     "kind": "compare",
     "field": "ent_inv_stock_count.reason",
     "operator": "present",
     "value": null,
     "other_field": null,
     "pass_outcome": null,
     "fail_outcome": null
    }
   },
   {
    "id": "rule_inv_decision",
    "description": "The manager's decision selects what happens to the count.",
    "type": "decision",
    "status": "assumption",
    "source": {
     "kind": "synthetic_assumption",
     "reference": "Catalog design assumption: the business has not stated this rule. It lets the demonstration run and is not company policy."
    },
    "condition": "",
    "outcomes": [
     "APPROVED",
     "REJECTED"
    ],
    "execution": {
     "kind": "value",
     "field": "ent_inv_stock_count.decision",
     "operator": "present",
     "value": null,
     "other_field": null,
     "pass_outcome": null,
     "fail_outcome": null
    }
   }
  ],
  "exceptions": [
