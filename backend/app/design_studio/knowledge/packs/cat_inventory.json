 "business": {
  "requirements": [
   {
    "id": "req_inv_count",
    "statement": "Stock is counted, and significant differences are approved before stock levels change.",
    "kind": "functional",
    "priority": "must",
    "status": "agreed",
    "acceptance_criteria": [
     {
      "id": "ac_inv_count_1",
      "statement": "A clerk records a count and its difference."
     },
     {
      "id": "ac_inv_count_2",
      "statement": "A difference above tolerance needs a manager's approval."
     },
     {
      "id": "ac_inv_count_3",
      "statement": "An approved count updates the stock level and writes a movement."
     }
    ]
   },
   {
    "id": "req_inv_visibility",
    "statement": "Current stock by item and location can be found quickly.",
    "kind": "functional",
    "priority": "should",
    "status": "agreed",
    "acceptance_criteria": [
     {
      "id": "ac_inv_visibility_1",
      "statement": "Stock levels can be searched by item or location."
     }
    ]
   },
   {
    "id": "req_inv_audit",
    "statement": "Every change to a record and every process step is recorded with who did it and when.",
    "kind": "non_functional",
    "category": "auditability",
    "priority": "must",
    "status": "agreed",
    "acceptance_criteria": [
     {
      "id": "ac_inv_audit_1",
      "statement": "The history of a process shows each step with its actor and time."
     }
    ]
   }
  ],
