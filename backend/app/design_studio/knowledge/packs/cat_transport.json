  "requirements": [
   {
    "id": "req_tms_deliver",
    "statement": "Shipments are planned, assigned, dispatched, tracked and confirmed with proof of delivery.",
    "kind": "functional",
    "priority": "must",
    "status": "agreed",
    "acceptance_criteria": [
     {
      "id": "ac_tms_deliver_1",
      "statement": "A planner assigns an active carrier and a vehicle that fits the load."
     },
     {
      "id": "ac_tms_deliver_2",
      "statement": "A dispatcher records tracking updates."
     },
     {
      "id": "ac_tms_deliver_3",
      "statement": "Delivery is confirmed with a receiver and a proof reference."
     }
    ]
   },
   {
    "id": "req_tms_recover",
    "statement": "Delayed or failed deliveries are resolved explicitly.",
    "kind": "functional",
    "priority": "should",
    "status": "agreed",
    "acceptance_criteria": [
     {
      "id": "ac_tms_recover_1",
      "statement": "A delay or failure leads to a recorded retry or cancellation."
     }
    ]
   },
   {
    "id": "req_tms_audit",
    "statement": "Every change to a record and every process step is recorded with who did it and when.",
    "kind": "non_functional",
    "category": "auditability",
    "priority": "must",
    "status": "agreed",
    "acceptance_criteria": [
     {
      "id": "ac_tms_audit_1",
      "statement": "The history of a process shows each step with its actor and time."
     }
    ]
   }
  ],
