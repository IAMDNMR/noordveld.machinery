  "rules": [
   {
    "id": "rule_wms_allocation",
    "description": "Stock can be allocated to an order line only if on-hand stock covers the quantity.",
    "type": "decision",
    "status": "assumption",
    "source": {
     "kind": "synthetic_assumption",
     "reference": "Catalog design assumption: the business has not stated this rule. It lets the demonstration run and is not company policy."
    },
    "condition": "",
    "outcomes": [
     "ALLOCATED",
     "SHORT"
    ],
    "execution": {
     "kind": "compare",
     "field": "ent_inv_stock_level.on_hand",
     "operator": "gte",
     "value": null,
     "other_field": "ent_eco_order_line.quantity",
     "pass_outcome": "ALLOCATED",
     "fail_outcome": "SHORT"
    }
   },
   {
    "id": "rule_wms_pick_complete",
    "description": "A pick is complete when the quantity picked covers the ordered quantity.",
    "type": "decision",
    "status": "assumption",
    "source": {
     "kind": "synthetic_assumption",
     "reference": "Catalog design assumption: the business has not stated this rule. It lets the demonstration run and is not company policy."
    },
    "condition": "",
    "outcomes": [
     "COMPLETE",
     "PARTIAL"
    ],
    "execution": {
     "kind": "compare",
     "field": "ent_wms_pick_line.quantity_picked",
     "operator": "gte",
     "value": null,
     "other_field": "ent_eco_order_line.quantity",
     "pass_outcome": "COMPLETE",
     "fail_outcome": "PARTIAL"
    }
   },
   {
    "id": "rule_wms_weight",
    "description": "A pack unit has a recorded weight before handoff.",
    "type": "validation",
    "status": "assumption",
    "source": {
     "kind": "synthetic_assumption",
     "reference": "Catalog design assumption: the business has not stated this rule. It lets the demonstration run and is not company policy."
    },
    "condition": "",
    "outcomes": [],
    "execution": {
     "kind": "compare",
     "field": "ent_wms_pack_unit.gross_weight_kg",
     "operator": "present",
     "value": null,
     "other_field": null,
     "pass_outcome": null,
     "fail_outcome": null
    }
   }
  ],
  "exceptions": [
   {
    "id": "exc_wms_shortage",
    "name": "Allocation is short",
    "trigger": "On-hand stock does not cover an order line.",
    "recovery": "The lead resolves the shortage and allocation is checked again.",
    "resolution": "recover",
    "resolution_state_id": "st_wms_fulfilment_allocate"
   },
   {
    "id": "exc_wms_short_pick",
    "name": "Pick is partial",
    "trigger": "The picker found less than ordered.",
    "recovery": "The lead decides how to continue and the pick is repeated.",
    "resolution": "recover",
    "resolution_state_id": "st_wms_fulfilment_pick"
   }
  ],
