 "business": {
  "requirements": [
   {
    "id": "req_wms_fulfil",
    "statement": "Ordered goods are allocated, picked, packed and handed off.",
    "kind": "functional",
    "priority": "must",
    "status": "agreed",
    "acceptance_criteria": [
     {
      "id": "ac_wms_fulfil_1",
      "statement": "Stock is allocated before picking starts."
     },
     {
      "id": "ac_wms_fulfil_2",
      "statement": "The picked quantity is checked against the order."
     },
     {
      "id": "ac_wms_fulfil_3",
      "statement": "A packed order has a weight and package count."
     }
    ]
   },
   {
    "id": "req_wms_shortage",
    "statement": "Shortages and partial picks are visible and resolved, not hidden.",
    "kind": "functional",
    "priority": "should",
    "status": "agreed",
    "acceptance_criteria": [
     {
      "id": "ac_wms_shortage_1",
      "statement": "A short allocation or partial pick is handled as an exception."
     }
    ]
   },
   {
    "id": "req_wms_audit",
    "statement": "Every change to a record and every process step is recorded with who did it and when.",
    "kind": "non_functional",
    "category": "auditability",
    "priority": "must",
    "status": "agreed",
    "acceptance_criteria": [
     {
      "id": "ac_wms_audit_1",
      "statement": "The history of a process shows each step with its actor and time."
     }
    ]
   }
  ],
