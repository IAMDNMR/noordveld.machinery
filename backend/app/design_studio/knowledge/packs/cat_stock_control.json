    "rules": [
      {
        "id": "rule_stk_level",
        "description": "A purchase request is created only when the item's projected quantity is not above its reorder level.",
        "type": "decision",
        "status": "confirmed",
        "source": {
          "kind": "document",
          "reference": "https://docs.frappe.io/erpnext/user/manual/en/auto-creation-of-material-request (Projected quantity above the reorder level leaves the item out of the request)"
        },
        "condition": "",
        "outcomes": [
          "ABOVE_LEVEL",
          "AT_OR_BELOW_LEVEL"
        ],
        "execution": {
          "kind": "compare",
          "field": "ent_stk_item.projected_quantity",
          "operator": "gt",
          "value": null,
          "other_field": "ent_stk_item.reorder_level",
          "pass_outcome": "ABOVE_LEVEL",
          "fail_outcome": "AT_OR_BELOW_LEVEL"
        }
      },
      {
        "id": "rule_stk_count",
        "description": "A counted quantity equal to the quantity in the system needs no adjustment; any difference is posted to the difference account.",
        "type": "decision",
        "status": "confirmed",
        "source": {
          "kind": "document",
          "reference": "https://docs.frappe.io/erpnext/user/manual/en/stock-reconciliation (Quantity is overwritten with the counted figure; difference account defaults to Stock Adjustment)"
        },
        "condition": "",
        "outcomes": [
          "MATCHES",
          "DIFFERENCE"
        ],
        "execution": {
          "kind": "compare",
          "field": "ent_stk_count_line.counted_quantity",
          "operator": "eq",
          "value": null,
          "other_field": "ent_stk_count_line.book_quantity",
          "pass_outcome": "MATCHES",
          "fail_outcome": "DIFFERENCE"
        }
      },
      {
        "id": "rule_stk_created",
        "description": "Automatic creation of the request either succeeds or fails and is reported to the purchase manager.",
        "type": "decision",
        "status": "confirmed",
        "source": {
          "kind": "document",
          "reference": "https://docs.frappe.io/erpnext/user/manual/en/auto-creation-of-material-request (If auto creation fails, the Purchase Manager is told the error message)"
        },
        "condition": "",
        "outcomes": [
          "CREATED",
          "FAILED"
        ],
        "execution": {
          "kind": "value",
          "field": "ent_stk_request.creation_result",
          "operator": "present",
          "value": null,
          "other_field": null,
          "pass_outcome": null,
          "fail_outcome": null
        }
      },
      {
        "id": "rule_stk_route",
        "description": "A transfer goes directly to the target warehouse or through a transit warehouse recorded in two entries.",
        "type": "decision",
        "status": "confirmed",
        "source": {
          "kind": "document",
          "reference": "https://docs.frappe.io/erpnext/user/manual/en/stock-entry (Transit: two entries, the second created with End Transit)"
        },
        "condition": "",
        "outcomes": [
          "DIRECT",
          "VIA_TRANSIT"
        ],
        "execution": {
          "kind": "value",
          "field": "ent_stk_transfer.route",
          "operator": "present",
          "value": null,
          "other_field": null,
          "pass_outcome": null,
          "fail_outcome": null
        }
      }
    ],
    "exceptions": [
      {
        "id": "exc_stk_auto_failed",
        "name": "Automatic request failed",
        "trigger": "Creating the material request automatically fails, for example because no fiscal year exists for the date.",
