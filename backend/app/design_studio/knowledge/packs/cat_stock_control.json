{
  "id": "cat_stock_control",
  "version": "2026.10.22",
  "layer": "business",
  "title": "Reorder, stock count and warehouse transfer",
  "description": "Automatic reordering from reorder levels, counting physical stock with a stock reconciliation, and moving stock between warehouses, as documented by the ERPNext stock manual.",
  "synthetic": false,
  "status": "approved",
  "provenance": {
    "kind": "verified_source",
    "reference": "Official documentation, read and checked 2026-10-21: docs.frappe.io/erpnext/user/manual/en/auto-creation-of-material-request; docs.frappe.io/erpnext/user/manual/en/material-request; docs.frappe.io/erpnext/user/manual/en/stock-reconciliation; docs.frappe.io/erpnext/user/manual/en/stock-entry",
    "verification": "verified"
  },
  "depends_on": [],
  "uses_capabilities": [
    "audit_history",
    "search_filter"
  ],
  "dependency_mode": "full",
  "includes": [],
  "business": {
    "requirements": [
      {
        "id": "req_stk_reorder",
        "statement": "When automatic reordering is enabled and an item's projected stock falls to its reorder level, a purchase material request is created for the item's reorder quantity, marked as auto-created, and the purchase manager is alerted; an item whose projected stock is above the reorder level is left out.",
        "kind": "functional",
        "priority": "must",
        "status": "agreed",
        "acceptance_criteria": [
          {
            "id": "ac_stk_reorder_1",
            "statement": "Each item can have a reorder level and a reorder quantity, also per warehouse."
          },
          {
            "id": "ac_stk_reorder_2",
            "statement": "One request is created for each item below its reorder level."
          }
        ]
      },
      {
        "id": "req_stk_reorder_fail",
        "statement": "When automatic creation of a request fails, the purchase manager is told the error.",
        "kind": "functional",
        "priority": "must",
        "status": "agreed",
        "acceptance_criteria": [
          {
            "id": "ac_stk_reorder_fail_1",
            "statement": "The error message reaches the purchase manager."
          }
        ]
      },
      {
        "id": "req_stk_count",
        "statement": "Physical stock is counted periodically and at year end; the counted quantity and the valuation rate are entered per item and warehouse, starting from the quantity and rate the system shows.",
        "kind": "functional",
        "priority": "must",
        "status": "agreed",
        "acceptance_criteria": [
          {
            "id": "ac_stk_count_1",
            "statement": "Each count line names an item and warehouse."
          },
          {
            "id": "ac_stk_count_2",
            "statement": "The system's current quantity and valuation rate are shown."
          }
        ]
      },
      {
        "id": "req_stk_adjust",
        "statement": "A submitted stock reconciliation overwrites the book quantity with the counted quantity; the value difference is posted to a difference account that defaults to stock adjustment, and the result can be checked in the stock ledger.",
        "kind": "functional",
        "priority": "must",
        "status": "agreed",
        "acceptance_criteria": [
          {
            "id": "ac_stk_adjust_1",
            "statement": "The difference account is confirmed before submission."
          },
          {
            "id": "ac_stk_adjust_2",
            "statement": "The updated balance appears in the stock ledger."
          }
        ]
      },
      {
        "id": "req_stk_transfer",
        "statement": "Stock is moved between warehouses with a material transfer stock entry, which deducts it from the source warehouse and adds it to the target warehouse; submitted entries can only be changed by cancelling and amending them.",
        "kind": "functional",
        "priority": "must",
        "status": "agreed",
        "acceptance_criteria": [
          {
            "id": "ac_stk_transfer_1",
            "statement": "A transfer names a source and a target warehouse."
          }
        ]
      },
      {
        "id": "req_stk_ledger",
        "statement": "Every stock movement is recorded in the stock ledger, so a count can be checked against the updated balance.",
        "kind": "non_functional",
        "priority": "should",
        "status": "agreed",
        "acceptance_criteria": [
          {
            "id": "ac_stk_ledger_1",
            "statement": "The updated balance can be checked in the stock ledger."
          }
        ],
        "category": "auditability"
      },
      {
        "id": "req_stk_transit",
        "statement": "A transfer through a transit warehouse is recorded in two entries: goods in transit, then the end of transit at the target warehouse; the transfer status is not started, in transit or completed.",
        "kind": "functional",
        "priority": "must",
        "status": "agreed",
        "acceptance_criteria": [
          {
            "id": "ac_stk_transit_1",
            "statement": "The transfer shows its status."
          }
        ]
      }
    ],
    "roles": [
