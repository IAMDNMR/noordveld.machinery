  "rules": [
   {
    "id": "rule_crm_discount",
    "description": "A discount above 10% needs a manager's approval.",
    "type": "decision",
    "status": "assumption",
    "source": {
     "kind": "synthetic_assumption",
     "reference": "Catalog design assumption: the business has not stated this rule. It lets the demonstration run and is not company policy."
    },
    "condition": "",
    "outcomes": [
     "STANDARD",
     "NEEDS_APPROVAL"
    ],
    "execution": {
     "kind": "compare",
     "field": "ent_crm_opportunity.discount_pct",
     "operator": "lte",
     "value": 10,
     "other_field": null,
     "pass_outcome": "STANDARD",
     "fail_outcome": "NEEDS_APPROVAL"
    }
   },
   {
    "id": "rule_crm_discount_decision",
    "description": "The manager's recorded decision selects what happens to the discount.",
    "type": "decision",
    "status": "assumption",
    "source": {
     "kind": "synthetic_assumption",
     "reference": "Catalog design assumption: the business has not stated this rule. It lets the demonstration run and is not company policy."
