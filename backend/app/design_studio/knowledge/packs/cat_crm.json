    ],
    "execution": {
     "kind": "value",
     "field": "ent_crm_opportunity.decision",
     "operator": "present",
     "value": null,
     "other_field": null,
     "pass_outcome": null,
     "fail_outcome": null
    }
   },
   {
    "id": "rule_crm_result",
