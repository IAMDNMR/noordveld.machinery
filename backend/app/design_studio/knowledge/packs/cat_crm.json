   {
    "id": "req_crm_sell",
    "statement": "Opportunities are qualified, proposed, negotiated and closed as won or lost.",
    "kind": "functional",
    "priority": "must",
    "status": "agreed",
    "acceptance_criteria": [
     {
      "id": "ac_crm_sell_1",
      "statement": "A rep records an opportunity for a customer."
     },
     {
      "id": "ac_crm_sell_2",
      "statement": "A discount above the standard limit is approved by a manager."
     },
     {
      "id": "ac_crm_sell_3",
      "statement": "An opportunity ends as won or lost."
     }
    ]
   },
   {
    "id": "req_crm_follow",
