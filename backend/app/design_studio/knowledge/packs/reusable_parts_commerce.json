{
  "id": "reusable_parts_commerce",
  "version": "2026.10.1",
  "layer": "reusable",
  "title": "Reusable knowledge: spare-parts commerce",
  "description": "Domain taxonomy and terminology that apply to any spare-parts business. Curated for the Design Studio demo; contains no business policy.",
  "synthetic": true,
  "domains": [
    {"id": "spare_parts_commerce", "name": "Spare-parts commerce", "subdomains": ["Part discovery", "Compatibility", "Ordering", "Fulfilment", "After-sales"],
     "keywords": ["spare", "spare-parts", "part", "parts", "fitment", "compatibility", "compatible", "catalogue", "catalog", "order", "ordering", "machine", "machinery", "dealer", "aftermarket"]},
    {"id": "order_management", "name": "Order management", "subdomains": ["Order capture", "Allocation", "Order lifecycle"],
     "keywords": ["order", "orders", "allocation", "allocate", "checkout", "cart", "cancel", "reject"]},
    {"id": "warranty_service", "name": "Warranty and service", "subdomains": ["Warranty claims", "Installation", "Dealer service"],
     "keywords": ["warranty", "claim", "claims", "installation", "install", "service", "repair", "maintenance"]},
    {"id": "logistics", "name": "Transport and logistics", "subdomains": ["Shipment", "Tracking", "Routes"],
     "keywords": ["shipment", "shipping", "delivery", "tracking", "transport", "route", "carrier", "depot", "warehouse"]},
    {"id": "inventory", "name": "Inventory and warehousing", "subdomains": ["Stock levels", "Reservations", "Replenishment"],
     "keywords": ["inventory", "stock", "warehouse", "depot", "reservation", "replenishment"]}
  ],
  "business": {
    "terms": [
      {"id": "term_fitment", "term": "Fitment", "definition": "A recorded statement that a part fits a machine (model or variant). Absence of a record is not proof that the part does not fit."},
      {"id": "term_depot", "term": "Depot", "definition": "A warehouse that holds stock and can be the origin of a shipment."},
      {"id": "term_allocation", "term": "Allocation", "definition": "Reserving stock for an order so that no other order can take the same units."},
      {"id": "term_idempotency_key", "term": "Idempotency key", "definition": "A client-chosen key that makes a repeated submission return the original result instead of creating a duplicate."},
      {"id": "term_unknown_stock", "term": "Unknown stock", "definition": "Stock with no recorded quantity. It is different from zero and must not be presented or used as zero."},
      {"id": "term_ship_to", "term": "Ship-to", "definition": "A recorded delivery destination."},
      {"id": "term_warranty_claim", "term": "Warranty claim", "definition": "A request to cover a failed installed part under a warranty policy."}
    ]
  }
}
