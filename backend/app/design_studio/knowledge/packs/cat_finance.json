      "writable": false,
      "sensitivity": "internal"
     },
     {
      "id": "amount",
      "name": "Amount",
      "type": "decimal",
      "required": true,
      "sensitivity": "internal",
      "minimum": 0
     },
     {
      "id": "currency",
      "name": "Currency",
      "type": "string",
      "required": true,
      "sensitivity": "internal",
