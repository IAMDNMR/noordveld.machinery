       "EUR",
       "USD",
       "GBP"
      ]
     },
     {
      "id": "issue_date",
      "name": "Issue date",
      "type": "date",
      "required": false,
      "sensitivity": "internal"
     },
     {
      "id": "due_date",
      "name": "Due date",
      "type": "date",
      "required": false,
      "sensitivity": "internal"
     },
     {
      "id": "status",
      "name": "Status",
      "type": "string",
      "required": true,
      "sensitivity": "internal",
      "enum": [
       "DRAFT",
       "ISSUED",
       "PAID",
       "OVERDUE",
       "CANCELLED"
