 "business": {
  "requirements": [
   {
    "id": "req_fin_bill",
    "statement": "Invoices are drafted, reviewed when large, issued and settled by payment.",
    "kind": "functional",
    "priority": "must",
    "status": "agreed",
    "acceptance_criteria": [
     {
      "id": "ac_fin_bill_1",
      "statement": "A clerk drafts an invoice for a customer."
     },
     {
      "id": "ac_fin_bill_2",
      "statement": "A large invoice is reviewed by the controller before it is issued."
     },
     {
      "id": "ac_fin_bill_3",
      "statement": "Payment is compared with the amount due."
     }
    ]
   },
   {
    "id": "req_fin_report",
    "statement": "Open and overdue invoices can be seen at a glance.",
    "kind": "functional",
    "priority": "should",
    "status": "agreed",
    "acceptance_criteria": [
     {
      "id": "ac_fin_report_1",
      "statement": "The home view shows invoices in progress and completed."
     }
    ]
   },
   {
    "id": "req_fin_audit",
    "statement": "Every change to a record and every process step is recorded with who did it and when.",
    "kind": "non_functional",
    "category": "auditability",
    "priority": "must",
    "status": "agreed",
    "acceptance_criteria": [
     {
      "id": "ac_fin_audit_1",
      "statement": "The history of a process shows each step with its actor and time."
     }
    ]
   }
  ],
  "roles": [
