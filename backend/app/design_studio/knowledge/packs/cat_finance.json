  "rules": [
   {
    "id": "rule_fin_review",
    "description": "An invoice above 10,000 is reviewed by the controller before it is issued.",
    "type": "decision",
    "status": "assumption",
    "source": {
     "kind": "synthetic_assumption",
     "reference": "Catalog design assumption: the business has not stated this rule. It lets the demonstration run and is not company policy."
    },
    "condition": "",
    "outcomes": [
     "AUTO_ISSUE",
     "NEEDS_REVIEW"
    ],
    "execution": {
     "kind": "compare",
     "field": "ent_fin_invoice.amount",
     "operator": "lte",
     "value": 10000,
     "other_field": null,
     "pass_outcome": "AUTO_ISSUE",
     "fail_outcome": "NEEDS_REVIEW"
    }
   },
   {
    "id": "rule_fin_decision",
    "description": "The controller's recorded decision selects what happens to the invoice.",
    "type": "decision",
    "status": "assumption",
    "source": {
     "kind": "synthetic_assumption",
     "reference": "Catalog design assumption: the business has not stated this rule. It lets the demonstration run and is not company policy."
    },
    "condition": "",
    "outcomes": [
     "APPROVED",
     "REJECTED"
    ],
    "execution": {
     "kind": "value",
     "field": "ent_fin_invoice.decision",
     "operator": "present",
     "value": null,
     "other_field": null,
     "pass_outcome": null,
     "fail_outcome": null
    }
   },
   {
    "id": "rule_fin_due",
    "description": "An invoice has a due date before it is issued.",
    "type": "validation",
    "status": "assumption",
    "source": {
     "kind": "synthetic_assumption",
     "reference": "Catalog design assumption: the business has not stated this rule. It lets the demonstration run and is not company policy."
    },
    "condition": "",
    "outcomes": [],
    "execution": {
     "kind": "compare",
     "field": "ent_fin_invoice.due_date",
     "operator": "present",
     "value": null,
     "other_field": null,
     "pass_outcome": null,
     "fail_outcome": null
    }
   },
   {
    "id": "rule_fin_settlement",
    "description": "An invoice is paid in full when the amount received covers it.",
    "type": "decision",
    "status": "assumption",
    "source": {
     "kind": "synthetic_assumption",
     "reference": "Catalog design assumption: the business has not stated this rule. It lets the demonstration run and is not company policy."
    },
    "condition": "",
    "outcomes": [
     "PAID_IN_FULL",
     "PARTIAL"
    ],
    "execution": {
     "kind": "compare",
     "field": "ent_fin_payment.amount_received",
     "operator": "gte",
     "value": null,
     "other_field": "ent_fin_invoice.amount",
     "pass_outcome": "PAID_IN_FULL",
     "fail_outcome": "PARTIAL"
    }
   }
  ],
  "exceptions": [
   {
    "id": "exc_fin_invoice_rejected",
    "name": "Invoice rejected on review",
