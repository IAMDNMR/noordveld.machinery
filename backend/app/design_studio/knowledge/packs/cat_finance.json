    "recovery": "The clerk amends the invoice and it is reviewed again.",
    "resolution": "recover",
    "resolution_state_id": "st_fin_billing_review"
   },
   {
    "id": "exc_fin_short_payment",
    "name": "Short payment",
    "trigger": "The amount received is less than the invoice.",
    "recovery": "The receivables clerk follows up and records the further payment.",
    "resolution": "recover",
    "resolution_state_id": "st_fin_billing_payment"
   }
