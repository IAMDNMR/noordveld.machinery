  "rules": [
   {
    "id": "rule_pro_limit",
    "description": "A requisition above 5,000 needs approval before it is ordered.",
    "type": "decision",
    "status": "assumption",
    "source": {
     "kind": "synthetic_assumption",
     "reference": "Catalog design assumption: the business has not stated this rule. It lets the demonstration run and is not company policy."
    },
    "condition": "",
    "outcomes": [
     "WITHIN_LIMIT",
     "NEEDS_APPROVAL"
    ],
    "execution": {
     "kind": "compare",
     "field": "ent_pro_requisition.estimated_cost",
     "operator": "lte",
     "value": 5000,
     "other_field": null,
     "pass_outcome": "WITHIN_LIMIT",
     "fail_outcome": "NEEDS_APPROVAL"
    }
   },
   {
    "id": "rule_pro_decision",
    "description": "The approver's recorded decision selects what happens to the requisition.",
    "type": "decision",
    "status": "assumption",
    "source": {
     "kind": "synthetic_assumption",
     "reference": "Catalog design assumption: the business has not stated this rule. It lets the demonstration run and is not company policy."
    },
    "condition": "",
    "outcomes": [
     "APPROVED",
     "REJECTED"
    ],
    "execution": {
     "kind": "value",
     "field": "ent_pro_requisition.decision",
     "operator": "present",
     "value": null,
     "other_field": null,
     "pass_outcome": null,
     "fail_outcome": null
    }
   },
   {
    "id": "rule_pro_match",
    "description": "Goods are accepted when the quantity received covers the quantity requested.",
    "type": "decision",
    "status": "assumption",
    "source": {
     "kind": "synthetic_assumption",
     "reference": "Catalog design assumption: the business has not stated this rule. It lets the demonstration run and is not company policy."
    },
    "condition": "",
    "outcomes": [
     "MATCH",
     "MISMATCH"
    ],
    "execution": {
     "kind": "compare",
     "field": "ent_pro_goods_receipt.quantity_received",
     "operator": "gte",
     "value": null,
     "other_field": "ent_pro_requisition.quantity",
     "pass_outcome": "MATCH",
     "fail_outcome": "MISMATCH"
    }
   }
  ],
  "exceptions": [
