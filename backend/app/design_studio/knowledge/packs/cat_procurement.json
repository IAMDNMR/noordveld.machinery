  "requirements": [
   {
    "id": "req_pro_buy",
    "statement": "Needs are requested, approved when above the limit, ordered and received.",
    "kind": "functional",
    "priority": "must",
    "status": "agreed",
    "acceptance_criteria": [
     {
      "id": "ac_pro_buy_1",
      "statement": "A requester raises a requisition for an item."
     },
     {
      "id": "ac_pro_buy_2",
      "statement": "A requisition above the limit is approved by someone else before ordering."
     },
     {
      "id": "ac_pro_buy_3",
      "statement": "Received goods are checked against what was requested."
     }
    ]
   },
   {
    "id": "req_pro_supplier",
    "statement": "Purchase orders name the supplier and expected delivery.",
    "kind": "functional",
    "priority": "should",
    "status": "agreed",
    "acceptance_criteria": [
     {
      "id": "ac_pro_supplier_1",
      "statement": "A purchase order refers to a supplier and a requisition."
     }
    ]
   },
   {
    "id": "req_pro_audit",
    "statement": "Every change to a record and every process step is recorded with who did it and when.",
    "kind": "non_functional",
    "category": "auditability",
    "priority": "must",
    "status": "agreed",
    "acceptance_criteria": [
     {
      "id": "ac_pro_audit_1",
