{
  "id": "cat_supplier_lifecycle",
  "version": "2026.10.22",
  "layer": "business",
  "title": "Supplier onboarding and performance scoring",
  "description": "Onboarding a prospective vendor through a reviewed vendor request, and scoring supplier performance over time, as documented by Microsoft Dynamics 365 and ERPNext.",
  "synthetic": false,
  "status": "approved",
  "provenance": {
    "kind": "verified_source",
    "reference": "Official documentation, read and checked 2026-10-21: learn.microsoft.com/en-us/dynamics365/supply-chain/procurement/vendor-onboarding; learn.microsoft.com/en-us/dynamics365/supply-chain/procurement/procurement-sourcing-workflows; docs.frappe.io/erpnext/user/manual/en/supplier-scorecard; docs.frappe.",
    "verification": "verified"
  },
  "depends_on": [],
  "uses_capabilities": [
    "approval_workflow",
    "audit_history",
    "search_filter"
  ],
  "dependency_mode": "full",
  "includes": [],
  "business": {
    "requirements": [
      {
        "id": "req_slc_onboard",
        "statement": "A procurement professional decides whether a prospective vendor should be onboarded.",
        "kind": "functional",
        "priority": "must",
        "status": "agreed",
        "acceptance_criteria": [
          {
            "id": "ac_slc_onboard_1",
            "statement": "A prospective vendor's name, justification and contact are reviewed before onboarding starts."
          }
        ]
      },
      {
        "id": "req_slc_register",
        "statement": "The vendor's contact person registers the vendor's information: addresses, business information, procurement categories and questionnaire answers.",
        "kind": "functional",
        "priority": "must",
        "status": "agreed",
        "acceptance_criteria": [
          {
            "id": "ac_slc_register_1",
            "statement": "The registration is submitted as a vendor request."
          }
        ]
      },
      {
        "id": "req_slc_approve",
        "statement": "A vendor request is reviewed and approved or rejected; the approver can ask for more information, and a rejection needs a reason; approval creates the supplier record.",
        "kind": "functional",
        "priority": "must",
        "status": "agreed",
        "acceptance_criteria": [
          {
            "id": "ac_slc_approve_1",
            "statement": "Approval creates the supplier record."
          },
          {
            "id": "ac_slc_approve_2",
            "statement": "A rejection records a reason."
          }
        ]
      },
      {
        "id": "req_slc_evaluate",
        "statement": "Supplier performance is scored over weekly, monthly or yearly periods against weighted criteria such as quotation response time, delivered item quality and delivery timeliness.",
        "kind": "functional",
        "priority": "must",
        "status": "agreed",
        "acceptance_criteria": [
          {
            "id": "ac_slc_evaluate_1",
            "statement": "Each criterion has a weight."
          },
          {
            "id": "ac_slc_evaluate_2",
            "statement": "A period's score feeds the supplier's current score."
          }
        ]
      },
      {
        "id": "req_slc_history",
        "statement": "The status and history of each vendor request can be tracked, as the procurement workflows provide.",
        "kind": "non_functional",
        "priority": "should",
        "status": "agreed",
        "acceptance_criteria": [
          {
            "id": "ac_slc_history_1",
            "statement": "Each vendor request's status and history are visible."
          }
        ],
        "category": "auditability"
      },
      {
        "id": "req_slc_standing",
        "statement": "A supplier's standing can warn users, or prevent them, from including the supplier in requests for quotation and purchase orders.",
        "kind": "functional",
        "priority": "must",
        "status": "agreed",
        "acceptance_criteria": [
          {
            "id": "ac_slc_standing_1",
            "statement": "The action for each standing is configurable."
          }
        ]
      }
    ],
    "roles": [
      {
        "id": "role_slc_procurement",
        "name": "Procurement professional",
        "responsibilities": [
          "Decides whether a vendor is onboarded",
          "Reviews and approves or rejects vendor requests",
          "Maintains supplier scorecards"
