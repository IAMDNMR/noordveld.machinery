  ],
  "dependency_mode": "full",
  "includes": [],
  "business": {
    "requirements": [
      {
        "id": "req_p2p_request",
        "statement": "A requester raises a purchase requisition for the items or services needed.",
        "kind": "functional",
        "priority": "must",
        "status": "agreed",
        "acceptance_criteria": [
          {
            "id": "ac_p2p_request_1",
            "statement": "A requisition lists items with quantities and a required-by date."
          },
          {
            "id": "ac_p2p_request_2",
            "statement": "The requester can submit it for review."
          }
        ]
      },
      {
        "id": "req_p2p_approve",
        "statement": "A requisition is reviewed by a purchasing agent and, when configured conditions apply, by the requester's manager, who approves, rejects or returns it for changes.",
        "kind": "functional",
        "priority": "must",
        "status": "agreed",
        "acceptance_criteria": [
          {
            "id": "ac_p2p_approve_1",
            "statement": "A reviewer can return a requisition for changes."
          },
          {
            "id": "ac_p2p_approve_2",
            "statement": "Only an approved requisition can become a purchase order."
          }
        ]
      },
      {
        "id": "req_p2p_order",
        "statement": "A purchasing agent creates a purchase order for an approved requisition and sends it to a supplier.",
        "kind": "functional",
        "priority": "must",
        "status": "agreed",
        "acceptance_criteria": [
          {
            "id": "ac_p2p_order_1",
            "statement": "The order names the supplier and lists the items to buy."
          }
        ]
      },
      {
        "id": "req_p2p_confirm",
        "statement": "The supplier's confirmation of the order and its confirmed date are recorded.",
        "kind": "functional",
        "priority": "must",
        "status": "agreed",
        "acceptance_criteria": [
          {
            "id": "ac_p2p_confirm_1",
            "statement": "The order confirmation number and confirmed receipt date are stored on the order."
          }
        ]
      },
      {
        "id": "req_p2p_receive",
        "statement": "Goods are received against the purchase order, recording received, accepted and rejected quantities; partial receipts leave a pending quantity and an order can be closed short.",
        "kind": "functional",
        "priority": "must",
        "status": "agreed",
        "acceptance_criteria": [
          {
            "id": "ac_p2p_receive_1",
            "statement": "Received, accepted and rejected quantities are recorded per item."
          },
          {
            "id": "ac_p2p_receive_2",
            "statement": "A partial receipt leaves the remaining quantity pending."
          }
        ]
      },
      {
        "id": "req_p2p_history",
        "statement": "The status and history of each requisition and order can be tracked, as the procurement workflows provide.",
        "kind": "non_functional",
        "priority": "should",
        "status": "agreed",
        "acceptance_criteria": [
          {
            "id": "ac_p2p_history_1",
            "statement": "Each document's status and history are visible."
          }
        ],
        "category": "auditability"
      },
      {
        "id": "req_p2p_track",
        "statement": "Everyone involved can see each order's status and how much has been received.",
        "kind": "functional",
        "priority": "should",
        "status": "agreed",
        "acceptance_criteria": [
          {
            "id": "ac_p2p_track_1",
            "statement": "Open orders are listed with status, required-by date, confirmed date and the share of items received."
          }
        ]
      }
    ],
