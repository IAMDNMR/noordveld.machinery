  "version": "2026.10.22",
  "layer": "business",
  "title": "Purchase requisition, order and receipt",
  "description": "Requesting, approving, ordering and receiving goods, with supplier confirmation and partial receipts, as documented by ERPNext and Microsoft Dynamics 365.",
  "synthetic": false,
  "status": "approved",
  "provenance": {
    "kind": "verified_source",
    "reference": "Official documentation, read and checked 2026-10-21: learn.microsoft.com/en-us/dynamics365/supply-chain/procurement/purchase-requisitions-workflow; docs.frappe.io/erpnext/user/manual/en/procurement-cycle-overview; docs.frappe.io/erpnext/user/manual/en/material-request; docs.frappe.io/erpnext/user/ma",
    "verification": "verified"
  },
  "depends_on": [],
  "uses_capabilities": [
