    "rules": [
      {
        "id": "rule_p2p_limit",
        "description": "Routing to the requester's manager depends on configured conditions, for example the amount exceeding the requester's spending limit.",
        "type": "decision",
        "status": "confirmed",
        "source": {
          "kind": "document",
          "reference": "https://learn.microsoft.com/en-us/dynamics365/supply-chain/procurement/purchase-requisitions-workflow (Example 1, step 3: routing when the amount exceeds the requester's spending limit)"
        },
        "condition": "",
        "outcomes": [
          "WITHIN_LIMIT",
          "NEEDS_MANAGER"
        ],
        "execution": {
          "kind": "compare",
          "field": "ent_p2p_requisition.estimated_total",
          "operator": "lte",
          "value": null,
          "other_field": "ent_p2p_requisition.requester_spending_limit",
          "pass_outcome": "WITHIN_LIMIT",
          "fail_outcome": "NEEDS_MANAGER"
        }
      },
      {
        "id": "rule_p2p_decision",
        "description": "The reviewer approves the requisition, rejects it, or returns it to the preparer for changes.",
        "type": "decision",
        "status": "confirmed",
        "source": {
          "kind": "document",
          "reference": "https://learn.microsoft.com/en-us/dynamics365/supply-chain/procurement/purchase-requisitions-workflow (Example 1, step 3: approve or reject, or return it to the preparer)"
        },
        "condition": "",
        "outcomes": [
          "APPROVED",
          "REJECTED",
          "RETURNED"
        ],
        "execution": {
          "kind": "value",
          "field": "ent_p2p_requisition.decision",
          "operator": "present",
          "value": null,
          "other_field": null,
          "pass_outcome": null,
          "fail_outcome": null
        }
      },
      {
        "id": "rule_p2p_remaining",
        "description": "After a partial receipt the remaining quantity is either still expected or the order is closed short.",
        "type": "decision",
        "status": "confirmed",
        "source": {
          "kind": "document",
          "reference": "https://docs.frappe.io/erpnext/user/manual/en/purchase-receipt (Closed is for short-closing: what was not received is neither received nor billed)"
        },
        "condition": "",
        "outcomes": [
          "STILL_EXPECTED",
          "CLOSE_SHORT"
        ],
        "execution": {
          "kind": "value",
          "field": "ent_p2p_order.remaining",
          "operator": "present",
          "value": null,
          "other_field": null,
          "pass_outcome": null,
          "fail_outcome": null
        }
      },
      {
        "id": "rule_p2p_pending",
        "description": "On a partial receipt the remaining quantity stays pending on the purchase order.",
        "type": "decision",
        "status": "confirmed",
        "source": {
          "kind": "document",
          "reference": "https://docs.frappe.io/erpnext/user/manual/en/purchase-receipt (Partial receipt updates the Pending Quantity in the Purchase Order)"
        },
        "condition": "",
        "outcomes": [
          "ALL_RECEIVED",
          "PARTIAL"
        ],
        "execution": {
          "kind": "compare",
          "field": "ent_p2p_order_line.received_quantity",
          "operator": "gte",
          "value": null,
          "other_field": "ent_p2p_order_line.quantity",
          "pass_outcome": "ALL_RECEIVED",
          "fail_outcome": "PARTIAL"
        }
      }
    ],
    "exceptions": [
      {
        "id": "exc_p2p_returned",
        "name": "Returned for changes",
        "trigger": "The purchasing agent or manager returns the requisition to the preparer.",
        "recovery": "The preparer makes the changes and submits the requisition again.",
        "resolution": "recover",
        "resolution_state_id": "st_p2p_req_submit"
      },
      {
        "id": "exc_p2p_rejected",
        "name": "Requisition rejected",
        "trigger": "The manager rejects the requisition.",
        "recovery": "The requisition ends without an order.",
        "resolution": "terminate",
        "resolution_state_id": "st_p2p_req_rejected"
      },
      {
        "id": "exc_p2p_partial",
        "name": "Partial receipt",
        "trigger": "Less than the ordered quantity has arrived.",
        "recovery": "The remaining quantity stays pending and the next receipt is recorded against the same order.",
        "resolution": "recover",
        "resolution_state_id": "st_p2p_ord_receive"
      },
      {
        "id": "exc_p2p_short_closed",
        "name": "Order closed short",
        "trigger": "The remaining quantity will not be delivered.",
        "recovery": "The order is closed; what was not received is neither received nor billed.",
        "resolution": "terminate",
        "resolution_state_id": "st_p2p_ord_closed"
      }
    ],
