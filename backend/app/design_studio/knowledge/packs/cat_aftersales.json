 "business": {
  "requirements": [
   {
    "id": "req_svc_resolve",
    "statement": "Service cases are logged, checked for warranty, scheduled, visited and closed.",
    "kind": "functional",
    "priority": "must",
    "status": "agreed",
    "acceptance_criteria": [
     {
      "id": "ac_svc_resolve_1",
      "statement": "A case records the customer, the machine and the problem."
     },
     {
      "id": "ac_svc_resolve_2",
      "statement": "Warranty status is decided from the machine's warranty end date."
     },
     {
      "id": "ac_svc_resolve_3",
      "statement": "A technician records the outcome of each visit."
     }
    ]
   },
   {
    "id": "req_svc_claims",
    "statement": "Warranty claims are decided by a warranty administrator.",
    "kind": "functional",
    "priority": "should",
    "status": "agreed",
    "acceptance_criteria": [
     {
      "id": "ac_svc_claims_1",
      "statement": "A claim is approved or rejected and the decision is recorded."
     }
    ]
   },
   {
    "id": "req_svc_audit",
    "statement": "Every change to a record and every process step is recorded with who did it and when.",
    "kind": "non_functional",
    "category": "auditability",
    "priority": "must",
    "status": "agreed",
    "acceptance_criteria": [
     {
      "id": "ac_svc_audit_1",
      "statement": "The history of a process shows each step with its actor and time."
     }
    ]
   }
  ],
