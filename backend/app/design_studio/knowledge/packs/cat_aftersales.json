  "rules": [
   {
    "id": "rule_svc_description",
    "description": "A case describes the problem.",
    "type": "validation",
    "status": "assumption",
    "source": {
     "kind": "synthetic_assumption",
     "reference": "Catalog design assumption: the business has not stated this rule. It lets the demonstration run and is not company policy."
    },
    "condition": "",
    "outcomes": [],
    "execution": {
     "kind": "compare",
     "field": "ent_svc_service_case.description",
     "operator": "present",
     "value": null,
     "other_field": null,
     "pass_outcome": null,
     "fail_outcome": null
    }
   },
   {
    "id": "rule_svc_warranty",
    "description": "A repair is in warranty when the service date is on or before the machine's warranty end.",
    "type": "decision",
    "status": "assumption",
    "source": {
     "kind": "synthetic_assumption",
     "reference": "Catalog design assumption: the business has not stated this rule. It lets the demonstration run and is not company policy."
    },
    "condition": "",
    "outcomes": [
     "IN_WARRANTY",
     "OUT_OF_WARRANTY"
    ],
    "execution": {
     "kind": "compare",
     "field": "ent_svc_service_case.service_date",
     "operator": "lte",
     "value": null,
     "other_field": "ent_mfg_machine.warranty_end",
     "pass_outcome": "IN_WARRANTY",
     "fail_outcome": "OUT_OF_WARRANTY"
    }
   },
   {
    "id": "rule_svc_claim_decision",
    "description": "The warranty administrator's recorded decision selects what happens to the claim.",
    "type": "decision",
    "status": "assumption",
    "source": {
     "kind": "synthetic_assumption",
     "reference": "Catalog design assumption: the business has not stated this rule. It lets the demonstration run and is not company policy."
    },
    "condition": "",
    "outcomes": [
     "APPROVED",
     "REJECTED"
    ],
    "execution": {
     "kind": "value",
     "field": "ent_svc_warranty_claim.decision",
     "operator": "present",
     "value": null,
     "other_field": null,
     "pass_outcome": null,
     "fail_outcome": null
    }
   },
   {
    "id": "rule_svc_outcome",
