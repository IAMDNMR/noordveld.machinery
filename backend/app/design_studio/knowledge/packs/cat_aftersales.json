       "OPEN",
       "TRIAGED",
       "SCHEDULED",
       "RESOLVED",
       "CLOSED"
      ]
     },
     {
      "id": "opened_on",
      "name": "Opened on",
      "type": "date",
      "required": true,
      "sensitivity": "internal"
     },
     {
      "id": "service_date",
