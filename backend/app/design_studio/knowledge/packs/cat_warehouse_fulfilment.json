    "rules": [
      {
        "id": "rule_whs_putaway",
        "description": "A received quantity is placed in warehouses by priority and free space; if no warehouse has free space the user is notified.",
        "type": "decision",
        "status": "confirmed",
        "source": {
          "kind": "document",
          "reference": "https://docs.frappe.io/erpnext/user/manual/en/putaway-rule (Capacity, priority, and notification when no warehouse has free space)"
        },
        "condition": "",
        "outcomes": [
          "PLACED",
          "NO_FREE_SPACE"
        ],
        "execution": {
          "kind": "value",
          "field": "ent_whs_receipt.putaway_result",
          "operator": "present",
          "value": null,
          "other_field": null,
          "pass_outcome": null,
          "fail_outcome": null
        }
      },
      {
        "id": "rule_whs_delivered",
        "description": "A delivery is complete when the delivered quantity reaches the ordered quantity, otherwise the rest is delivered on another delivery note.",
        "type": "decision",
        "status": "confirmed",
        "source": {
          "kind": "document",
          "reference": "https://docs.frappe.io/erpnext/user/manual/en/delivery-note (Partial Deliveries: of 10 items, deliver 5 one week and 5 the next on two delivery notes)"
        },
        "condition": "",
        "outcomes": [
          "ALL_DELIVERED",
          "PARTIAL"
        ],
        "execution": {
          "kind": "compare",
          "field": "ent_whs_delivery_line.delivered_quantity",
          "operator": "gte",
          "value": null,
          "other_field": "ent_whs_delivery_line.ordered_quantity",
          "pass_outcome": "ALL_DELIVERED",
          "fail_outcome": "PARTIAL"
        }
      }
    ],
