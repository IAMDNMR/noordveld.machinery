{
  "id": "cat_warehouse_fulfilment",
  "version": "2026.10.22",
  "layer": "business",
  "title": "Warehouse receiving, putaway, picking, delivery and returns",
  "description": "How goods are received and put away by rules, picked from stock, delivered in full or in parts, and returned, as documented by the ERPNext stock manual.",
  "synthetic": false,
  "status": "approved",
  "provenance": {
    "kind": "verified_source",
    "reference": "Official documentation, read and checked 2026-10-21: docs.frappe.io/erpnext/user/manual/en/putaway-rule; docs.frappe.io/erpnext/user/manual/en/pick-list; docs.frappe.io/erpnext/user/manual/en/delivery-note",
    "verification": "verified"
  },
  "depends_on": [],
  "uses_capabilities": [
    "audit_history",
    "search_filter"
  ],
  "dependency_mode": "full",
  "includes": [],
  "business": {
    "requirements": [
      {
        "id": "req_whs_receive",
        "statement": "Incoming goods are registered on a receipt.",
        "kind": "functional",
        "priority": "must",
        "status": "agreed",
        "acceptance_criteria": [
          {
            "id": "ac_whs_receive_1",
            "statement": "A receipt lists the items and quantities received."
          }
        ]
      },
      {
        "id": "req_whs_putaway",
        "statement": "Each received item is assigned to a warehouse by putaway rules: one rule per item and warehouse, with a priority (1 is highest) and a capacity; a warehouse is filled up to its capacity, then the next eligible warehouse is used; when no warehouse has free space the user is notified.",
        "kind": "functional",
        "priority": "must",
        "status": "agreed",
        "acceptance_criteria": [
          {
            "id": "ac_whs_putaway_1",
            "statement": "The received quantity is split across warehouses by priority and free space."
          },
          {
            "id": "ac_whs_putaway_2",
            "statement": "The user is notified when there is no free space."
          }
        ]
      },
      {
        "id": "req_whs_pick",
        "statement": "A pick list records which items to take from which warehouse to fulfil a sales order that is not yet fully picked; warehouses are chosen first-in-first-out and, for batched items, the batch closest to expiry; it is saved for the picker and submitted when picking is complete.",
        "kind": "functional",
        "priority": "must",
        "status": "agreed",
        "acceptance_criteria": [
          {
            "id": "ac_whs_pick_1",
            "statement": "A pick list shows the warehouse for every item."
          },
          {
            "id": "ac_whs_pick_2",
            "statement": "A pick list is submitted after picking with the picked quantities."
          }
        ]
      },
      {
        "id": "req_whs_deliver",
        "statement": "A delivery note is created from a submitted pick list when a shipment leaves the warehouse; on submission stock is updated with a stock ledger entry per item; its status shows draft, to bill, completed, return issued, cancelled or closed.",
        "kind": "functional",
        "priority": "must",
        "status": "agreed",
        "acceptance_criteria": [
          {
            "id": "ac_whs_deliver_1",
            "statement": "A delivery note can only be created after the pick list is submitted."
          },
          {
            "id": "ac_whs_deliver_2",
            "statement": "Submitting a delivery note updates stock."
          }
        ]
      },
      {
        "id": "req_whs_partial",
        "statement": "An order can be delivered in parts on several delivery notes, for example half one week and half the next; a delivery note can be closed short so that unsent quantities are neither sent nor billed.",
        "kind": "functional",
        "priority": "must",
        "status": "agreed",
        "acceptance_criteria": [
          {
            "id": "ac_whs_partial_1",
            "statement": "Pending quantity on the order is updated by each delivery note."
          }
        ]
      },
      {
        "id": "req_whs_ledger",
        "statement": "Every stock movement is recorded as a stock ledger entry when a document is submitted, so balances can be traced.",
        "kind": "non_functional",
        "priority": "should",
        "status": "agreed",
        "acceptance_criteria": [
          {
            "id": "ac_whs_ledger_1",
            "statement": "Each submitted delivery or return has a stock ledger entry per item."
          }
        ],
        "category": "auditability"
      },
      {
        "id": "req_whs_return",
        "statement": "Items returned by a customer are recorded as a sales return against the delivery; when all items are returned the delivery note shows return issued.",
        "kind": "functional",
        "priority": "must",
        "status": "agreed",
        "acceptance_criteria": [
          {
            "id": "ac_whs_return_1",
            "statement": "A return updates stock."
          }
        ]
      }
    ],
