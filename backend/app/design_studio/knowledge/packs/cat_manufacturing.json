  "requirements": [
   {
    "id": "req_mfg_work",
    "statement": "Work orders are planned against machines and parts, carried out, inspected and closed.",
    "kind": "functional",
    "priority": "must",
    "status": "agreed",
    "acceptance_criteria": [
     {
      "id": "ac_mfg_work_1",
      "statement": "A planner creates a work order for a machine."
     },
     {
      "id": "ac_mfg_work_2",
      "statement": "Parts availability is checked before work starts."
     },
     {
      "id": "ac_mfg_work_3",
      "statement": "Work is accepted only after a passing inspection."
     }
    ]
   },
   {
    "id": "req_mfg_register",
    "statement": "The machines in service and the parts they need are on record.",
    "kind": "functional",
    "priority": "should",
    "status": "agreed",
    "acceptance_criteria": [
     {
      "id": "ac_mfg_register_1",
      "statement": "A machine has a serial number, model and warranty end date."
     },
     {
      "id": "ac_mfg_register_2",
      "statement": "A machine's parts list can be maintained."
     }
    ]
   },
   {
    "id": "req_mfg_audit",
    "statement": "Every change to a record and every process step is recorded with who did it and when.",
    "kind": "non_functional",
    "category": "auditability",
    "priority": "must",
    "status": "agreed",
    "acceptance_criteria": [
     {
      "id": "ac_mfg_audit_1",
      "statement": "The history of a process shows each step with its actor and time."
     }
    ]
   }
  ],
