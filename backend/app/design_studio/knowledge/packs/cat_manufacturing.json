     "fail_outcome": null
    }
   },
   {
    "id": "rule_mfg_material",
    "description": "A work order can start only if on-hand stock covers the parts it needs.",
    "type": "decision",
    "status": "assumption",
    "source": {
     "kind": "synthetic_assumption",
     "reference": "Catalog design assumption: the business has not stated this rule. It lets the demonstration run and is not company policy."
    },
    "condition": "",
    "outcomes": [
     "AVAILABLE",
     "SHORT"
    ],
    "execution": {
     "kind": "compare",
     "field": "ent_inv_stock_level.on_hand",
     "operator": "gte",
     "value": null,
     "other_field": "ent_mfg_bom_line.quantity",
     "pass_outcome": "AVAILABLE",
     "fail_outcome": "SHORT"
    }
   },
   {
    "id": "rule_mfg_inspection",
    "description": "The inspector's recorded result decides whether work is accepted.",
    "type": "decision",
    "status": "assumption",
